# Strava API credentials — copy to .env and fill in. NEVER commit .env.
# Create an app at https://www.strava.com/settings/api
# (Authorization Callback Domain = localhost), then run: python -m strava_photobook auth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# GitHub OAuth App（需启用 Device Flow）。Client ID 可公开，token 严禁提交。
GITHUB_CLIENT_ID=
GITHUB_TOKEN=

# —— 可选：入册照片数调优（默认动态，通常无需设置）——
# 不设 PHOTOBOOK_PHOTOS_PER_BOOK 时，按当年上传照片数动态决定：
#   目标 = min(上传数, clamp(round(上传数 * RATIO), FLOOR, CAP))
# PHOTOBOOK_PHOTO_RATIO=0.60
# PHOTOBOOK_PHOTO_FLOOR=40
# PHOTOBOOK_PHOTO_CAP=120
# PHOTOBOOK_MAX_PHOTOS_PER_RIDE=6
# 逃生舱：设置后强制固定入册张数，忽略上面的动态规则。
# PHOTOBOOK_PHOTOS_PER_BOOK=40
